# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Load it when running scripts, e.g.:
#   uv run --env-file .env scripts/generate_character_sheets.py --send
# (or `export $(grep -v '^#' .env | xargs)`, or prefix: `GEMINI_API_KEY=... uv run ...`)

# Required: Google Gemini API key for image generation (character sheets + page
# images), the gemini-3.5-flash description step, and the Antigravity orchestrator.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: directory for the rembg segmentation model cache (default: ~/.u2net).
# U2NET_HOME=

# Note: inside a Google Antigravity sandbox the key is injected via the network
# proxy, so you do NOT set GEMINI_API_KEY there — pass --allow-proxy-auth instead.
